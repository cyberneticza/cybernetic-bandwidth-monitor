<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon only (Services\TrayIcon.cs). Part of the Windows Desktop runtime, so no
         package, but the self-contained publish grows by about 11 MB to carry it. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 wants DPI mode moved out of app.manifest into WinForms' startup API. This is a
         WPF app; the manifest is what WPF reads, so it stays. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NetTrace.ico</ApplicationIcon>
    <AssemblyName>NetTrace</AssemblyName>
    <RootNamespace>NetTrace.App</RootNamespace>
    <!-- WPF and CsWinRT both rely on reflection the trimmer cannot see. Do not enable trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Program.Main picks service, setup or window before WPF starts; see Program.cs. -->
    <StartupObject>NetTrace.App.Program</StartupObject>
  </PropertyGroup>

  <!-- WinForms and WPF both define Application, MessageBox, Color and friends. Keep WinForms out
       of the global usings; the one file that needs it aliases the namespace. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by build\make-icon.ps1. ApplicationIcon embeds it in the exe for Explorer and
         shortcuts; the Resource copy is what the window and taskbar load. -->
    <Resource Include="Assets\NetTrace.ico" />
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetTrace.Core\NetTrace.Core.csproj" />
    <ProjectReference Include="..\NetTrace.Data\NetTrace.Data.csproj" />
  </ItemGroup>
</Project>
