<UserControl x:Class="NetTrace.App.Views.GraphsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NetTrace.App.Converters"
             xmlns:ui="clr-namespace:NetTrace.App.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

  <UserControl.Resources>
    <conv:BytesConverter x:Key="Bytes" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:InverseBoolConverter x:Key="NotBusy" />
  </UserControl.Resources>

  <!-- Wide: fills the window, the overview and the day sharing its height. Narrow or short: scrolls. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
  <Grid Margin="{StaticResource PagePadding}" MinHeight="620" ui:Layout.CompactBelow="720" ui:Layout.FillViewport="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="210" />
      <RowDefinition Height="16" />
      <RowDefinition Height="3*" MinHeight="300" />
    </Grid.RowDefinitions>

    <!-- ======================================================== toolbar + period totals -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <WrapPanel VerticalAlignment="Bottom">
        <StackPanel Margin="0,0,16,8">
          <TextBlock Text="Period" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding TimeWindows}" Width="160"
                    DisplayMemberPath="Label" SelectedValuePath="Value"
                    SelectedValue="{Binding SelectedWindow}" />
        </StackPanel>

        <StackPanel Margin="0,0,16,8">
          <TextBlock Text="Direction" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding Directions}" Width="150"
                    DisplayMemberPath="Label" SelectedValuePath="Value"
                    SelectedValue="{Binding Direction}" />
        </StackPanel>

        <Button Content="Refresh" Command="{Binding ReloadCommand}" VerticalAlignment="Bottom" Margin="0,0,16,8"
                IsEnabled="{Binding IsBusy, Converter={StaticResource NotBusy}}" />
      </WrapPanel>

      <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="16,6" VerticalAlignment="Bottom">
        <StackPanel>
          <TextBlock Text="{Binding PeriodLabel}" Style="{StaticResource MutedText}" />
          <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
            <TextBlock Text="&#xE74B;" Style="{StaticResource IconText}" Margin="0,0,5,0"
                       Foreground="{DynamicResource DownloadBrush}" />
            <TextBlock Text="{Binding PeriodBytesReceived, Converter={StaticResource Bytes}}"
                       Style="{StaticResource HeadingText}" Typography.NumeralAlignment="Tabular" />
            <TextBlock Text="&#xE74A;" Style="{StaticResource IconText}" Margin="16,0,5,0"
                       Foreground="{DynamicResource UploadBrush}" />
            <TextBlock Text="{Binding PeriodBytesSent, Converter={StaticResource Bytes}}"
                       Style="{StaticResource HeadingText}" Typography.NumeralAlignment="Tabular" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ======================================================== daily overview -->
    <Border Grid.Row="1" Style="{StaticResource Panel}">
      <DockPanel>
        <!-- One line: every pixel of height here is taken from the chart. -->
        <Grid DockPanel.Dock="Top" Margin="18,12,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Daily usage" Style="{StaticResource HeadingText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" Margin="12,0,12,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="Click a day to open it below · Ctrl + scroll to zoom · drag to pan · double-click to reset"
                       ToolTip="Click a day to open it below · Ctrl + scroll to zoom · drag to pan · double-click to reset" />
          </Grid>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource DownloadBrush}"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="Downloaded" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource UploadBrush}"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="Uploaded" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="Reset zoom"
                    Command="{Binding ResetOverviewZoomCommand}" />
          </StackPanel>
        </Grid>

        <Grid Margin="8,0,8,6">
          <lvc:CartesianChart Series="{Binding OverviewSeries}"
                              XAxes="{Binding OverviewXAxes}"
                              YAxes="{Binding OverviewYAxes}"
                              Sections="{Binding OverviewSections}"
                              LegendPosition="Hidden"
                              TooltipPosition="Top"
                              TooltipTextPaint="{Binding TooltipTextPaint}"
                              TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
                              ZoomMode="X" ui:ChartZoom.RequireCtrl="True"
                              DoubleClickCommand="{Binding ResetOverviewZoomCommand}" />

          <TextBlock Text="{Binding OverviewMessage}" Style="{StaticResource MutedText}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" IsHitTestVisible="False"
                     Visibility="{Binding OverviewMessage, Converter={StaticResource NullToVisibility}}" />
        </Grid>
      </DockPanel>
    </Border>

    <!-- ======================================================== selected day -->
    <ui:AdaptiveColumns Grid.Row="3">
      <Border Style="{StaticResource Panel}" ui:AdaptiveColumns.StackedHeight="420">
        <DockPanel>
          <!-- Two rows so the long date never collides with the controls at narrow widths:
               which day on top, what it contains and how it is drawn underneath. -->
          <Grid DockPanel.Dock="Top" Margin="10,8,10,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.ColumnSpan="2">
              <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Previous day"
                      Command="{Binding PreviousDayCommand}" />
              <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Next day"
                      Command="{Binding NextDayCommand}" />
              <TextBlock Text="{Binding SelectedDayLabel}" Style="{StaticResource HeadingText}"
                         VerticalAlignment="Center" Margin="8,0,12,0" />
              <Button Content="Go to today" Padding="10,4" Command="{Binding TodayCommand}" VerticalAlignment="Center" />
              <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding DayEventsText, Converter={StaticResource NullToVisibility}}"
                         ToolTip="Marked on the chart. The Network page lists them in full.">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DayHasProblems}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AlertBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
                <Run Text="{Binding DayEventsText, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0"
                         ToolTip="Hold Ctrl and scroll over the chart to zoom; drag to pan; double-click to reset">
                <Run Text="&#xE71E;" FontFamily="{StaticResource IconFont}" />
                <Run Text="Ctrl + scroll to zoom" />
              </TextBlock>
            </WrapPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6,2,0,0" VerticalAlignment="Center">
              <TextBlock Text="&#xE74B;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,4,0"
                         Foreground="{DynamicResource DownloadBrush}" />
              <TextBlock Text="{Binding DayBytesReceived, Converter={StaticResource Bytes}}"
                         Style="{StaticResource BodyText}" Typography.NumeralAlignment="Tabular" />
              <TextBlock Text="&#xE74A;" Style="{StaticResource IconText}" FontSize="12" Margin="14,0,4,0"
                         Foreground="{DynamicResource UploadBrush}" />
              <TextBlock Text="{Binding DayBytesSent, Converter={StaticResource Bytes}}"
                         Style="{StaticResource BodyText}" Typography.NumeralAlignment="Tabular" />
              <TextBlock Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center">
                <Run Text="·" />
                <Run Text="{Binding DetailResolutionLabel, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>

            <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" HorizontalAlignment="Right">
              <TextBlock Text="Detail" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox ItemsSource="{Binding Resolutions}" Width="116" Margin="0,0,12,0"
                        DisplayMemberPath="Label" SelectedItem="{Binding SelectedResolution}" />
              <CheckBox Content="Stack" IsChecked="{Binding IsStacked}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="Reset zoom"
                      Command="{Binding ResetDetailZoomCommand}" />
            </WrapPanel>
          </Grid>

          <TextBlock DockPanel.Dock="Top" Text="{Binding DetailMessage}" Style="{StaticResource MutedText}"
                     Foreground="{DynamicResource UploadBrush}" TextWrapping="Wrap" Margin="16,6,16,0"
                     Visibility="{Binding DetailMessage, Converter={StaticResource NullToVisibility}}" />

          <Grid>
            <!-- Hover detail comes from the popup below: the built-in tooltip is drawn inside the
                 chart and runs off its bottom edge on a day with many applications. -->
            <lvc:CartesianChart x:Name="DetailChart" Margin="8,4,8,8"
                                Series="{Binding DetailSeries}"
                                XAxes="{Binding DetailXAxes}"
                                YAxes="{Binding DetailYAxes}"
                                Sections="{Binding DetailSections}"
                                LegendPosition="Hidden"
                                TooltipPosition="Hidden"
                                ZoomMode="X" ui:ChartZoom.RequireCtrl="True"
                                DoubleClickCommand="{Binding ResetDetailZoomCommand}"
                                MouseMove="OnDetailMouseMove"
                                MouseLeave="OnDetailMouseLeave" />

            <Popup x:Name="DetailHover" PlacementTarget="{Binding ElementName=DetailChart}" Placement="Relative"
                   IsOpen="{Binding IsHoverOpen, Mode=OneWay}" AllowsTransparency="True" StaysOpen="True"
                   IsHitTestVisible="False" Focusable="False">
              <Border Style="{StaticResource Panel}" Background="{DynamicResource RaisedBrush}"
                      Padding="12,10" Margin="0,0,12,12" MinWidth="220" MaxWidth="360">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" />
                </Border.Effect>
                <StackPanel>
                  <TextBlock Text="{Binding HoverTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding HoverTotals}" Style="{StaticResource MutedText}" Margin="0,1,0,6"
                             Typography.NumeralAlignment="Tabular" />
                  <ItemsControl ItemsSource="{Binding HoverRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Swatch}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyText}"
                                     TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                          <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource NumericText}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding HoverFootnote}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                             Margin="0,6,0,0"
                             Visibility="{Binding HoverFootnote, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Panel}" ui:AdaptiveColumns.FixedWidth="380" ui:AdaptiveColumns.StackedHeight="380">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="18,14,18,8">
            <TextBlock Text="Applications that day" Style="{StaticResource HeadingText}" />
            <TextBlock Text="Tick applications to chart only those."
                       Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <DataGrid ItemsSource="{Binding DayApps}" Margin="8,0,8,8">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Application" Width="*" SortMemberPath="DisplayName">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0" VerticalAlignment="Center" />
                      <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Margin="2,0,8,0"
                                 Fill="{Binding Swatch}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Down" Width="78" SortMemberPath="BytesReceived"
                                  Binding="{Binding BytesReceived, Converter={StaticResource Bytes}}"
                                  ElementStyle="{StaticResource NumericText}" />
              <DataGridTextColumn Header="Up" Width="78" SortMemberPath="BytesSent"
                                  Binding="{Binding BytesSent, Converter={StaticResource Bytes}}"
                                  ElementStyle="{StaticResource NumericText}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </ui:AdaptiveColumns>
  </Grid>
  </ScrollViewer>
</UserControl>
