<UserControl x:Class="NetTrace.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NetTrace.App.Converters">

  <UserControl.Resources>
    <conv:EnumEqualsConverter x:Key="EnumEquals" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
    <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="780" HorizontalAlignment="Left">

      <Border Style="{StaticResource Panel}" Padding="18" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource IconBadge}" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource DownloadSoftBrush}">
              <TextBlock Text="&#xE790;" Style="{StaticResource IconBadgeGlyph}" FontSize="15" Foreground="{DynamicResource DownloadBrush}" />
            </Border>
            <TextBlock Text="Appearance" Style="{StaticResource HeadingText}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>

          <Border Background="{DynamicResource RaisedBrush}" CornerRadius="6" Padding="2"
                  HorizontalAlignment="Left" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme" Content="System"
                           IsChecked="{Binding ThemePreference, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
              <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme" Content="Light"
                           IsChecked="{Binding ThemePreference, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
              <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme" Content="Dark"
                           IsChecked="{Binding ThemePreference, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding ThemeSummary}" Style="{StaticResource MutedText}"
                     TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <!-- ======================================================== running in the background -->
      <Border Style="{StaticResource Panel}" Padding="18" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource IconBadge}" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource DownloadSoftBrush}">
              <TextBlock Text="&#xE9F5;" Style="{StaticResource IconBadgeGlyph}" FontSize="15" Foreground="{DynamicResource DownloadBrush}" />
            </Border>
            <TextBlock Text="Running in the background" Style="{StaticResource HeadingText}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>

          <!-- Start at sign-in -->
          <CheckBox Content="Start NetTrace when I sign in" IsChecked="{Binding StartWithWindows}" Margin="0,14,0,0" />
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="26,2,0,0"
                     Text="Opens NetTrace quietly in the notification area each time you sign in, through a scheduled task for your account only. No administrator rights needed." />
          <TextBlock Text="{Binding SignInError}" Style="{StaticResource BodyText}" Foreground="{DynamicResource AlertBrush}"
                     TextWrapping="Wrap" Margin="26,4,0,0"
                     Visibility="{Binding SignInError, Converter={StaticResource NullToVisibility}}" />

          <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="0,16,0,14" />

          <!-- Windows service -->
          <TextBlock Text="Windows service" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0">
            <Run Text="Records from the moment Windows starts, whether or not anyone is signed in, and keeps recording when this window is closed. NetTrace's window then shows the service's data." />
            <LineBreak />
            <Run Text="Installing and removing it asks for administrator approval once. While it is installed, the history lives in" />
            <Run Text="{Binding SharedDirectory, Mode=OneWay}" />
            <Run Text="and every user of this PC can read it." />
          </TextBlock>

          <Border Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="2,5,12,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsServiceGood}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource DownloadBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsServiceWarning}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource UploadBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding ServiceStatusText}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ServiceStatusDetail}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Visibility="{Binding ServiceStatusDetail, Converter={StaticResource NullToVisibility}}" />
              </StackPanel>
            </Grid>
          </Border>

          <WrapPanel Margin="0,12,0,0">
            <Button Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,8" Command="{Binding InstallServiceCommand}"
                    Visibility="{Binding CanInstallService, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA18;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                <TextBlock Text="Install service" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Content="Start service" Margin="0,0,8,8" Command="{Binding StartServiceCommand}"
                    Visibility="{Binding CanStartService, Converter={StaticResource BoolToVisibility}}" />
            <Button Margin="0,0,8,8" Command="{Binding UpdateServiceCommand}"
                    Visibility="{Binding CanUpdateService, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA18;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                <TextBlock Text="Update service" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Margin="0,0,8,8" Command="{Binding RemoveServiceCommand}"
                    Visibility="{Binding CanRemoveService, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA18;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                <TextBlock Text="Remove service" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </WrapPanel>

          <TextBlock Text="{Binding ServiceProgress}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"
                     Visibility="{Binding ServiceProgress, Converter={StaticResource NullToVisibility}}" />
          <TextBlock Text="{Binding ServiceError}" Style="{StaticResource BodyText}" Foreground="{DynamicResource AlertBrush}"
                     TextWrapping="Wrap" Margin="0,2,0,0"
                     Visibility="{Binding ServiceError, Converter={StaticResource NullToVisibility}}" />
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="The buttons with a shield ask for administrator approval. Removing the service copies the history back to your own folder and NetTrace records in this window again." />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Panel}" Padding="18" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource IconBadge}" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource UploadSoftBrush}">
              <TextBlock Text="&#xEA8F;" Style="{StaticResource IconBadgeGlyph}" FontSize="15" Foreground="{DynamicResource UploadBrush}" />
            </Border>
            <TextBlock Text="Monitoring and alerts" Style="{StaticResource HeadingText}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>

          <CheckBox Content="Check connection quality every 30 seconds" IsChecked="{Binding HealthChecksEnabled}" Margin="0,12,0,0" />
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="26,2,0,0"
                     Text="Pings your router and sends a tiny HTTPS request to Cloudflare to measure response time: a few kilobytes a check, about 10 MB a day, and only every 5 minutes on metered connections. Powers the quality status on Live and Network, and the 'internet down' and 'slow' events." />

          <CheckBox Content="Notify me when one application uses a lot of data" IsChecked="{Binding HogAlertsEnabled}" Margin="0,14,0,0" />
          <WrapPanel Margin="26,6,0,0">
            <TextBlock Text="More than" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding HogThresholds}" SelectedItem="{Binding HogThreshold}" Width="90"
                      IsEnabled="{Binding HogAlertsEnabled}" ItemStringFormat="{}{0} MB" />
            <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"
                       Text="a minute, for 3 minutes in a row. At most once an hour per application." />
          </WrapPanel>

          <TextBlock Text="Data budget" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,16,0,0" />
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,8"
                     Text="For capped plans and hotspots. Progress shows on Live; a notification comes at 80% and 100%. Leave empty for no budget." />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Daily" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Width="90" Text="{Binding DailyBudget, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Grid.Column="2" Text="GB a day" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="8,0,0,0" />

            <TextBlock Grid.Row="1" Text="Monthly" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Width="90" Margin="0,8,0,0" Text="{Binding MonthlyBudget, UpdateSourceTrigger=LostFocus}" />
            <WrapPanel Grid.Row="1" Grid.Column="2" Margin="8,8,0,0">
              <TextBlock Text="GB, starting again on day" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox ItemsSource="{Binding ResetDays}" SelectedItem="{Binding BudgetResetDay}" Width="70" />
              <TextBlock Text="of each month" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </WrapPanel>
          </Grid>
          <TextBlock Text="{Binding BudgetError}" Style="{StaticResource BodyText}" Foreground="{DynamicResource AlertBrush}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Panel}" Padding="18" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource IconBadge}" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource DownloadSoftBrush}">
              <TextBlock Text="&#xE9D2;" Style="{StaticResource IconBadgeGlyph}" FontSize="15" Foreground="{DynamicResource DownloadBrush}" />
            </Border>
            <TextBlock Text="Where the data comes from" Style="{StaticResource HeadingText}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource BodyText}"
                     TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"
                     Text="NetTrace runs without administrator rights, which rules out packet capture. Byte counts come from the Windows data-usage service and settle roughly once a minute; socket details come from the connection table and refresh every few seconds." />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Panel}" Padding="18" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource IconBadge}" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource RaisedBrush}">
              <TextBlock Text="&#xEDA2;" Style="{StaticResource IconBadgeGlyph}" FontSize="15" Foreground="{DynamicResource TextBrush}" />
            </Border>
            <TextBlock Text="Storage" Style="{StaticResource HeadingText}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Folder" Style="{StaticResource MutedText}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataDirectory}"
                       Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Database" Style="{StaticResource MutedText}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseSize}"
                       Style="{StaticResource BodyText}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Retention" Style="{StaticResource MutedText}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RetentionSummary}"
                       Style="{StaticResource BodyText}" TextWrapping="Wrap" />
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Open folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
            <Button Content="Compact now" Command="{Binding CompactNowCommand}" Margin="0,0,8,0" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Panel}" Padding="18">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource IconBadge}" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource RaisedBrush}">
              <TextBlock Text="&#xE916;" Style="{StaticResource IconBadgeGlyph}" FontSize="15" Foreground="{DynamicResource TextBrush}" />
            </Border>
            <TextBlock Text="Sampling" Style="{StaticResource HeadingText}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding SamplingSummary}" Style="{StaticResource BodyText}"
                     TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="Edit appsettings.json next to the executable to change these." />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
