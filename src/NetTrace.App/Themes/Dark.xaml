<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Direction is the one thing colour carries here: cool for bytes coming down, warm for bytes
    going up. Every chart, every arrow and every column header follows that pairing, so a glance
    at a graph tells you which way the traffic went before you read a single label.

    Light.xaml must define exactly the same keys.
  -->
  <Color x:Key="GroundColor">#10141A</Color>
  <Color x:Key="SurfaceColor">#171C24</Color>
  <Color x:Key="RaisedColor">#1E242E</Color>
  <Color x:Key="HoverColor">#252C38</Color>
  <Color x:Key="LineColor">#2A323E</Color>
  <Color x:Key="TextColor">#E6EAF0</Color>
  <Color x:Key="MutedColor">#8894A6</Color>
  <Color x:Key="DownloadColor">#4FB6CE</Color>
  <Color x:Key="UploadColor">#E3A857</Color>
  <Color x:Key="AlertColor">#D2706B</Color>
  <Color x:Key="WarningSurfaceColor">#2A2318</Color>
  <Color x:Key="SelectionColor">#1D3540</Color>

  <SolidColorBrush x:Key="GroundBrush"         Color="{StaticResource GroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush"        Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="RaisedBrush"         Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="HoverBrush"          Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="LineBrush"           Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="TextBrush"           Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush"          Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="DownloadBrush"       Color="{StaticResource DownloadColor}" />
  <SolidColorBrush x:Key="UploadBrush"         Color="{StaticResource UploadColor}" />
  <SolidColorBrush x:Key="AlertBrush"          Color="{StaticResource AlertColor}" />
  <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
  <SolidColorBrush x:Key="SelectionBrush"      Color="{StaticResource SelectionColor}" />

  <!-- Tints behind icon badges and status pills: the direction and alert hues at low strength. -->
  <Color x:Key="DownloadSoftColor">#173A45</Color>
  <Color x:Key="UploadSoftColor">#3A2E1B</Color>
  <Color x:Key="AlertSoftColor">#3E2524</Color>
  <Color x:Key="ShadowColor">#000000</Color>

  <SolidColorBrush x:Key="DownloadSoftBrush"   Color="{StaticResource DownloadSoftColor}" />
  <SolidColorBrush x:Key="UploadSoftBrush"     Color="{StaticResource UploadSoftColor}" />
  <SolidColorBrush x:Key="AlertSoftBrush"      Color="{StaticResource AlertSoftColor}" />

  <!-- The brand mark's two directions, for the few places that carry the identity. -->
  <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource DownloadColor}" Offset="0" />
    <GradientStop Color="{StaticResource UploadColor}" Offset="1" />
  </LinearGradientBrush>

</ResourceDictionary>
