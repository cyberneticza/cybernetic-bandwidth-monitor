<Application x:Class="NetTrace.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NetTrace.App.ViewModels"
             xmlns:views="clr-namespace:NetTrace.App.Views">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Slot 0 is the colour palette. ThemeService replaces it with Light.xaml or Dark.xaml
             at startup and whenever the theme changes; nothing else may be inserted ahead of it. -->
        <ResourceDictionary Source="Themes/Dark.xaml" />
        <!-- Controls.xaml merges Tokens.xaml (type and sizes) itself. -->
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- View resolution by view-model type. Navigation just swaps a view model. -->
      <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:GraphsViewModel}">
        <views:GraphsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
        <views:HistoryView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
        <views:NetworkView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SpeedTestViewModel}">
        <views:SpeedTestView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:LogsViewModel}">
        <views:LogsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:AboutViewModel}">
        <views:AboutView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
