<UserControl x:Class="CyberneticBandwidth.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CyberneticBandwidth.App.Converters"
             xmlns:ui="clr-namespace:CyberneticBandwidth.App.Controls"
             xmlns:models="clr-namespace:CyberneticBandwidth.Core.Models;assembly=CyberneticBandwidth.Core"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

  <UserControl.Resources>
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:ZeroToVisibleConverter x:Key="ZeroToVisible" />

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="Margin" Value="0,0,12,6" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <!-- Wide: fills the window, the quality chart taking what is left. Narrow or short: scrolls. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
  <Grid Margin="{StaticResource PagePadding}" MinHeight="600" ui:Layout.CompactBelow="720" ui:Layout.FillViewport="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="*" MinHeight="280" />
    </Grid.RowDefinitions>

    <!-- ======================================================== now -->
    <ui:AdaptiveColumns Grid.Row="0">

      <!-- What you are connected to -->
      <Border Style="{StaticResource Panel}" Padding="20,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconBadge}" Background="{DynamicResource DownloadSoftBrush}">
              <TextBlock Text="{Binding MediumGlyph}" Style="{StaticResource IconBadgeGlyph}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding NetworkName}" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding MediumName, Mode=OneWay}" />
                <Run Text="·" />
                <Run Text="{Binding LinkSpeed, Mode=OneWay}" />
                <Run Text="·" />
                <Run Text="{Binding Reachability, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </Grid>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Address" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Addresses}" Style="{StaticResource FieldValue}" Margin="0,0,16,6" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Router" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Gateways}" Style="{StaticResource FieldValue}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="DNS" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DnsServers}" Style="{StaticResource FieldValue}" Margin="0,0,16,6" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Data" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CostText}" Style="{StaticResource FieldValue}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Adapter" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Adapter}" Style="{StaticResource FieldValue}" Margin="0,0,16,6" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Signal" Style="{StaticResource FieldLabel}"
                       Visibility="{Binding Signal, Converter={StaticResource NullToVisibility}}" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Signal}" Style="{StaticResource FieldValue}"
                       Visibility="{Binding Signal, Converter={StaticResource NullToVisibility}}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Routes}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold">
                      <Run Text="&#xE72E;" FontFamily="{StaticResource IconFont}" />
                      <Run Text="{Binding Name, Mode=OneWay}" />
                      <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- How well it is working -->
      <Border Style="{StaticResource Panel}" Padding="20,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Connection quality" Style="{StaticResource EyebrowText}" />
              <TextBlock Text="{Binding StatusName}" Style="{StaticResource HealthStatusText}"
                         FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource SizeHero}" FontWeight="SemiBold" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding OpenSpeedTestCommand}" VerticalAlignment="Top" Margin="12,0,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEC4A;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                <TextBlock Text="Run a speed test" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock Text="{Binding StatusMeaning}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,6,0,0" />

          <ui:AdaptiveGrid MinItemWidth="84" MaxColumns="4" Spacing="10" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Internet" Style="{StaticResource MutedText}" ToolTip="Round trip of a small HTTPS request, the median of three" />
              <TextBlock Text="{Binding InternetLatency}" Style="{StaticResource TitleText}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Jitter" Style="{StaticResource MutedText}" ToolTip="How much the round trip varies; high jitter makes calls choppy" />
              <TextBlock Text="{Binding Jitter}" Style="{StaticResource TitleText}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Failed" Style="{StaticResource MutedText}" ToolTip="Share of requests that got no answer" />
              <TextBlock Text="{Binding Loss}" Style="{StaticResource TitleText}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Router" Style="{StaticResource MutedText}" ToolTip="Ping to your router: slow or no reply points at Wi-Fi or the local network" />
              <TextBlock Text="{Binding GatewayLatency}" Style="{StaticResource TitleText}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
          </ui:AdaptiveGrid>

          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,14,0,0">
            <Run Text="{Binding LastChecked, Mode=OneWay}" />
            <Run Text="· Slow router times point at Wi-Fi or the local network; a quick router with a slow or failing internet points further out." />
          </TextBlock>
        </StackPanel>
      </Border>
    </ui:AdaptiveColumns>

    <!-- ======================================================== history -->
    <ui:AdaptiveColumns Grid.Row="2">
      <Border Style="{StaticResource Panel}" ui:AdaptiveColumns.StackedHeight="340">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="18,14,12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Quality over time" Style="{StaticResource HeadingText}" />
              <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap">
                <Run Text="■" Foreground="{DynamicResource DownloadBrush}" />
                <Run Text="internet" />
                <Run Text="  ■" Foreground="{DynamicResource MutedBrush}" />
                <Run Text="router" />
                <Run Text="  ■" Foreground="{DynamicResource AlertBrush}" />
                <Run Text="unreachable" />
              </TextBlock>
              <TextBlock Text="{Binding ProblemSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0">
                <Run Text="&#xE71E;" FontFamily="{StaticResource IconFont}" />
                <Run Text="Ctrl + scroll to zoom · drag to pan" />
              </TextBlock>
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Ranges}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedRange}" Width="140" VerticalAlignment="Top" Margin="12,0,0,0" />
          </Grid>

          <Grid Margin="8,4,8,8">
            <lvc:CartesianChart Series="{Binding HistorySeries}"
                                XAxes="{Binding HistoryXAxes}"
                                YAxes="{Binding HistoryYAxes}"
                                Sections="{Binding HistorySections}"
                                LegendPosition="Hidden"
                                TooltipPosition="Top"
                                TooltipTextPaint="{Binding TooltipTextPaint}"
                                TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
                                ZoomMode="X" ui:ChartZoom.RequireCtrl="True" />
            <TextBlock Text="{Binding HistoryMessage}" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="360" TextAlignment="Center" IsHitTestVisible="False"
                       Visibility="{Binding HistoryMessage, Converter={StaticResource NullToVisibility}}" />
          </Grid>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Panel}" ui:AdaptiveColumns.FixedWidth="380" ui:AdaptiveColumns.StackedHeight="420">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="18,14,18,8">
            <TextBlock Text="What happened" Style="{StaticResource HeadingText}" />
            <TextBlock Text="Drops, network switches, VPN changes and slow spells over the last 7 days."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>

          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,8" ui:Layout.PassWheelAtEnd="True">
              <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="8,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Glyph}" VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AlertBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource MutedText}"
                                 Margin="10,2,0,0" VerticalAlignment="Top" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="Nothing yet. Events appear here as Cybernetic Bandwidth Monitor notices them."
                       Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Events.Count, Converter={StaticResource ZeroToVisible}}" />
          </Grid>
        </DockPanel>
      </Border>
    </ui:AdaptiveColumns>
  </Grid>
  </ScrollViewer>
</UserControl>
