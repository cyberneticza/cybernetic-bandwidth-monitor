<Window x:Class="CyberneticBandwidth.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CyberneticBandwidth.App.Converters"
        Title="Cybernetic Bandwidth Monitor" Icon="/Assets/CyberneticBandwidth.ico" Width="1280" Height="820" MinWidth="760" MinHeight="540"
        Background="{DynamicResource GroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- One look for both rail lists. The glyph takes its colour from the item's Tag, which the
         NavItem style lights up for the selected page. Labels hide when the rail is compact; the
         tooltip then names the page. -->
    <DataTemplate x:Key="NavItemTemplate">
      <StackPanel Orientation="Horizontal">
        <StackPanel.ToolTip>
          <ToolTip Content="{Binding Label}"
                   Visibility="{Binding DataContext.IsRailCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel.ToolTip>
        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="16" Width="22"
                   Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="12,0,0,0"
                   Visibility="{Binding DataContext.IsRailCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ======================================================== navigation rail -->
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Width" Value="224" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsRailCompact}" Value="True">
              <Setter Property="Width" Value="68" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>

      <DockPanel>
        <!-- Brand -->
        <Grid DockPanel.Dock="Top" Margin="18,22,12,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Source="/Assets/CyberneticBandwidth.ico" Width="32" Height="32" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Cybernetic Bandwidth Monitor" />
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding IsRailCompact, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <!-- The full name is too wide for the rail on one line, so it stacks. -->
            <TextBlock Text="Cybernetic" Style="{StaticResource HeadingText}" FontSize="17" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Bandwidth Monitor" Style="{StaticResource MutedText}" FontSize="12" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>

        <!-- Bottom of the rail: Settings and About, and the running version. The theme is chosen in Settings. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="18,0,18,8" />
          <ListBox ItemsSource="{Binding FooterItems}"
                   SelectedItem="{Binding FooterSelection, Mode=TwoWay}"
                   ItemContainerStyle="{StaticResource NavItem}"
                   ItemTemplate="{StaticResource NavItemTemplate}"
                   Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
          <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="24,10,20,0"
                     Visibility="{Binding IsRailCompact, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Items}"
                 SelectedItem="{Binding PageSelection, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource NavItem}"
                 ItemTemplate="{StaticResource NavItemTemplate}"
                 Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      </DockPanel>
    </Border>

    <!-- ======================================================== content -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Page title: where you are, and what the page is for. -->
      <StackPanel x:Name="PageHeader" Grid.Row="0" Margin="28,22,28,14">
        <TextBlock Text="{Binding SelectedItem.Label}" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="{Binding SelectedItem.Description}" Style="{StaticResource MutedText}" FontSize="{StaticResource SizeBody}"
                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- Shown only when a data source is missing or degraded. Says what still works. -->
      <Border Grid.Row="1" Margin="28,0,28,14" Padding="14,10"
              CornerRadius="{StaticResource CardRadius}"
              Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource UploadBrush}" BorderThickness="1"
              Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}"
                     Foreground="{DynamicResource UploadBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource BodyText}"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <ContentControl x:Name="PageHost" Grid.Row="2" Content="{Binding SelectedItem.Content}" Focusable="False">
        <ContentControl.RenderTransform>
          <TranslateTransform x:Name="PageShift" />
        </ContentControl.RenderTransform>
      </ContentControl>
    </Grid>
  </Grid>
</Window>
